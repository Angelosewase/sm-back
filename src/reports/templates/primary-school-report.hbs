<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Report</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            padding: 20px;
            background-color: #f5f5f5;
        }

        .report-card {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border: 3px solid #000;
            padding: 0;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 2px solid #000;
        }

        .logo-placeholder {
            width: 150px;
            height: 80px;
            border: 2px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #999;
        }

        .school-info {
            text-align: center;
            flex: 1;
            margin: 0 20px;
        }

        .school-name {
            font-weight: bold;
            font-size: 18px;
            color: #1E90FF;
            margin-bottom: 5px;
        }

        .school-details {
            font-size: 12px;
            line-height: 1.5;
        }

        .student-info {
            display: flex;
            justify-content: space-between;
            padding: 15px 20px;
            background-color: #f9f9f9;
            border-bottom: 2px solid #000;
        }

        .student-info div {
            font-size: 13px;
        }

        .bulletin-title {
            text-align: center;
            padding: 10px;
            font-weight: bold;
            border-bottom: 2px solid #000;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #B3E5FF;
            padding: 12px;
            text-align: left;
            font-size: 13px;
            font-weight: bold;
            border: 1px solid #000;
        }

        td {
            padding: 12px;
            border: 1px solid #000;
            font-size: 13px;
            background-color: white;
        }

        .subject-row td:first-child {
            font-weight: normal;
        }

        .percentage-row {
            background-color: #f9f9f9;
            font-weight: bold;
        }

        .code-section {
            padding: 15px 20px;
            border-top: 2px solid #000;
            display: flex;
            gap: 40px;
        }

        .code-section div {
            font-size: 12px;
            line-height: 1.6;
        }

        .teacher-section {
            padding: 20px;
            border-top: 2px solid #000;
        }

        .teacher-name {
            font-size: 13px;
            margin-bottom: 10px;
        }

        .signature-placeholder {
            width: 200px;
            height: 60px;
            border: 2px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #999;
            margin-top: 10px;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 20px;
            border-top: 2px solid #000;
        }

        .director-section {
            flex: 1;
        }

        .school-stamp {
            width: 150px;
            height: 100px;
            border: 2px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: #999;
            text-align: center;
            padding: 10px;
        }

        .director-title {
            font-weight: bold;
            font-size: 13px;
            margin-bottom: 5px;
        }
    </style>
</head>
<body>
    <div class="report-card">
        <!-- Header -->
        <div class="header">
            {{#if assets.logoPath}}
            <img src="{{assets.logoPath}}" alt="Logo" style="width:150px;height:80px;object-fit:contain;border:2px solid #ccc;" />
            {{else}}
            <div class="logo-placeholder">Logo</div>
            {{/if}}
            <div class="school-info">
                <div class="school-name">{{#if school.name}}{{school.name}}{{else}}SCHOOL{{/if}}</div>
                <div class="school-details">
                    {{#if school.email}}{{school.email}}<br>{{/if}}
                    {{#if school.phone}}Phone: {{school.phone}}{{/if}}
                </div>
            </div>
            <div class="logo-placeholder">Cambridge Assessment</div>
        </div>

        <!-- Student Info -->
        <div class="student-info">
            <div><strong>Student Name:</strong> {{student.fullName}}</div>
            <div>
                {{#if report.period}}
                    {{#if report.periodLabel}}
                        <strong>{{report.periodLabel}}:</strong>
                    {{/if}}
                    {{report.period}}
                {{/if}}
            </div>
        </div>
        <div class="student-info" style="border-bottom: none;">
            <div><strong>Class:</strong> {{student.class}}</div>
            {{#if student.additionalInfo}}
                <div>{{student.additionalInfo}}</div>
            {{/if}}
        </div>

        <!-- Title -->
        <div class="bulletin-title">
            {{#if report.title}}
                {{report.title}}
            {{else}}
                MID-TERM REPORT
            {{/if}}
        </div>

        <!-- Grades Table -->
        {{#if yearView}}
          <table>
            <thead>
              <tr>
                <th>SUBJECT</th>
                {{#each yearView.terms}}
                  <th style="text-align: center;">{{label}} Max</th>
                  <th style="text-align: center;">{{label}} Score</th>
                  <th style="text-align: center;">{{label}} Grade</th>
                {{/each}}
              </tr>
            </thead>
            <tbody>
              {{#each yearView.subjects}}
                <tr class="subject-row">
                  <td>{{name}}</td>
                  {{#each byTerm}}
                    <td style="text-align: center;">{{maximum}}</td>
                    <td style="text-align: center;">{{obtained}}</td>
                    <td style="text-align: center;">{{grade}}</td>
                  {{/each}}
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <table>
              <thead>
                  <tr>
                      <th>SUBJECT</th>
                      <th style="text-align: center;">MAX</th>
                      <th style="text-align: center;">SCORE</th>
                      <th style="text-align: center;">GRADE</th>
                      <th>COMMENTS</th>
                  </tr>
              </thead>
              <tbody>
                  {{#if subjects}}
                      {{#each subjects}}
                          <tr class="subject-row">
                              <td>{{name}}</td>
                              <td style="text-align: center;">{{maximum}}</td>
                              <td style="text-align: center;">{{obtained}}</td>
                              <td style="text-align: center;">{{grade}}</td>
                              <td>{{comment}}</td>
                          </tr>
                      {{/each}}
                  {{else}}
                      <tr class="subject-row">
                          <td colspan="5" style="text-align: center;">No subjects available</td>
                      </tr>
                  {{/if}}
                  {{#if summary.percentage}}
                      <tr class="percentage-row">
                          <td>
                              <strong>
                                  {{#if summary.percentageLabel}}
                                      {{summary.percentageLabel}}
                                  {{else}}
                                      Percentage
                                  {{/if}}
                              </strong>
                          </td>
                          <td style="text-align: center;"><strong>{{summary.percentage}}</strong></td>
                          <td colspan="3">
                              {{#if summary.notes}}
                                  {{summary.notes}}
                              {{/if}}
                          </td>
                      </tr>
                  {{/if}}
              </tbody>
          </table>
        {{/if}}

        <!-- Code Section -->
        <div class="code-section">
            <div>
                <strong>Scale</strong>
            </div>
            <div>
                A: EXCELLENT (9-10)<br>
                B: VERY GOOD (7-8)
            </div>
            <div>
                C: GOOD (5-6)<br>
                D: PASS (0-4)
            </div>
        </div>

        <!-- Teacher Section -->
        <div class="teacher-section">
            <div class="teacher-name">
                {{#if teacher.name}}
                    Class teacher: {{teacher.name}}
                {{else}}
                    Class teacher
                {{/if}}
            </div>
            {{#if teacher.additionalNotes}}
                <div class="teacher-name">{{teacher.additionalNotes}}</div>
            {{/if}}
            <div class="signature-placeholder">Signature</div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="director-section">
                <div class="director-title">DIRECTOR</div>
                <div class="director-title">SIGNATURE AND SCHOOL STAMP</div>
                <div class="signature-placeholder">Signature</div>
            </div>
            <div class="school-stamp">
                {{#if school.name}}{{school.name}}<br>{{/if}}
                {{#if school.phone}}TEL: {{school.phone}}<br>{{/if}}
                KIGALI - RWANDA
            </div>
        </div>
    </div>
</body>
</html>