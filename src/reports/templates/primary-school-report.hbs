                </tr>
                <tr class="percentage-row">
                    <td><strong>Percentage</strong></td>
                    <td style="text-align: center;"><strong>56.2%</strong></td>
                    <td colspan="3"></td>
                </tr>
            </tbody>
        </table>

        <!-- Code Section -->
        <div class="code-section">
            <div>
                <strong>Code</strong>
            </div>
            <div>
                A: EXCELLENT (9-10)<br>
                B: TRÈS BIEN (7-8)
            </div>
            <div>
                C: BIEN (5-6)<br>
                D: PASSABLE (0-4)
            </div>
        </div>

        <!-- Teacher Section -->
        <div class="teacher-section">
            <div class="teacher-name">Titulaire de la classe: MAPENDO MIRINDI PASCALINE</div>
            <div class="signature-placeholder">Signature</div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="director-section">
                <div class="director-title">DIRECTEUR: UGIRAMAHORO ISSA</div>
                <div class="director-title">SIGNATURE ET CACHET DE L'ÉCOLE</div>
                <div class="signature-placeholder">Signature</div>
            </div>
            <div class="school-stamp">
                MALAIKA INTERNATIONAL SCHOOL<br>
                TEL: 0788532632<br>
                B.P 7483<br>
                KIGALI - RWANDA
            </div>
        </div>
    </div>
</body>
</html>