<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bulletin Scolaire</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            padding: 20px;
            background-color: #f5f5f5;
        }

        .report-card {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border: 3px solid #000;
            padding: 0;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 2px solid #000;
        }

        .logo-placeholder {
            width: 150px;
            height: 80px;
            border: 2px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #999;
        }

        .school-info {
            text-align: center;
            flex: 1;
            margin: 0 20px;
        }

        .school-name {
            font-weight: bold;
            font-size: 18px;
            color: #8B4513;
            margin-bottom: 5px;
        }

        .school-details {
            font-size: 12px;
            line-height: 1.5;
        }

        .student-info {
            display: flex;
            justify-content: space-between;
            padding: 15px 20px;
            background-color: #f9f9f9;
            border-bottom: 2px solid #000;
        }

        .student-info div {
            font-size: 13px;
        }

        .bulletin-title {
            text-align: center;
            padding: 10px;
            font-weight: bold;
            border-bottom: 2px solid #000;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #D2B48C;
            padding: 12px;
            text-align: left;
            font-size: 13px;
            font-weight: bold;
            border: 1px solid #000;
        }

        td {
            padding: 12px;
            border: 1px solid #000;
            font-size: 13px;
            background-color: white;
        }

        .subject-row td:first-child {
            font-weight: normal;
        }

        .percentage-row {
            background-color: #f9f9f9;
            font-weight: bold;
        }

        .code-section {
            padding: 15px 20px;
            border-top: 2px solid #000;
            display: flex;
            gap: 40px;
        }

        .code-section div {
            font-size: 12px;
            line-height: 1.6;
        }

        .teacher-section {
            padding: 20px;
            border-top: 2px solid #000;
        }

        .teacher-name {
            font-size: 13px;
            margin-bottom: 10px;
        }

        .signature-placeholder {
            width: 200px;
            height: 60px;
            border: 2px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #999;
            margin-top: 10px;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 20px;
            border-top: 2px solid #000;
        }

        .director-section {
            flex: 1;
        }

        .school-stamp {
            width: 150px;
            height: 100px;
            border: 2px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: #999;
            text-align: center;
            padding: 10px;
        }

        .director-title {
            font-weight: bold;
            font-size: 13px;
            margin-bottom: 5px;
        }
    </style>
</head>
<body>
    <div class="report-card">
        <!-- Header -->
