<html lang='fr'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Bulletin Scolaire - Badges</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        padding: 20px;
        background-color: #f5f5f5;
      }

      .report-card {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border: 3px solid #000;
        padding: 0;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        border-bottom: 2px solid #000;
      }

      .logo-placeholder {
        width: 150px;
        height: 80px;
        border: 2px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: #999;
      }

      .school-info {
        text-align: center;
        flex: 1;
        margin: 0 20px;
      }

      .school-name {
        font-weight: bold;
        font-size: 18px;
        color: #8b4513;
        margin-bottom: 5px;
      }

      .school-details {
        font-size: 12px;
        line-height: 1.5;
      }

      .student-info {
        padding: 15px 20px;
        background-color: #f9f9f9;
        border-bottom: 2px solid #000;
        font-size: 13px;
        font-weight: bold;
      }

      .student-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
      }

      .bulletin-title {
        text-align: center;
        padding: 10px;
        font-weight: bold;
        border-bottom: 2px solid #000;
      }

      .legend-table {
        width: 100%;
        border-collapse: collapse;
      }

      .legend-table td {
        padding: 15px;
        text-align: center;
        border: 1px solid #000;
        background-color: #d2b48c;
        font-weight: bold;
      }

      .badge-row td {
        background-color: white;
        padding: 20px;
      }

      .badge {
        width: 120px;
        height: 60px;
        border-radius: 50%;
        margin: 0 auto;
      }

      .badge-yellow {
        background-color: #ffd700;
      }

      .badge-green {
        background-color: #006400;
      }

      .badge-blue {
        background-color: #0000ff;
      }

      .badge-orange {
        background-color: #ff8c00;
      }

      .subjects-table {
        width: 100%;
        border-collapse: collapse;
      }

      .subjects-table td {
        padding: 15px;
        border: 1px solid #000;
        vertical-align: top;
      }

      .subject-cell {
        background-color: white;
      }

      .subject-name {
        font-size: 13px;
        margin-bottom: 10px;
      }

      .teacher-section {
        padding: 20px;
        border-top: 2px solid #000;
      }

      .teacher-name {
        font-size: 13px;
        margin-bottom: 10px;
      }

      .signature-placeholder {
        width: 200px;
        height: 60px;
        border: 2px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: #999;
        margin-top: 10px;
      }

      .footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
        border-top: 2px solid #000;
      }

      .director-section {
        flex: 1;
      }

      .school-stamp {
        width: 150px;
        height: 100px;
        border: 2px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #999;
        text-align: center;
        padding: 10px;
      }

      .director-title {
        font-weight: bold;
        font-size: 13px;
        margin-bottom: 5px;
      }
    </style>
  </head>
  <body>
    <div class='report-card'>
      <!-- Header -->
      <div class='header'>
        <div class='logo-placeholder'>Logo</div>
        <div class='school-info'>
          <div class='school-name'>MALAIKA INTERNATIONAL SCHOOL</div>
          <div class='school-details'>
            CAMBRIDGE AND PURE FRENCH PROGRAMS<br />
            malaika.int.school@gmail.com<br />
            Phone: +250 788 532 632
          </div>
        </div>
        <div class='logo-placeholder'>Cambridge Assessment</div>
      </div>

      <!-- Student Info -->
      <div class='student-info'>
        <div class='student-row'>
          <span>Nom et prénom: Mironko Asher Beckett</span>
          <span>2025-26 (Term 1)</span>
        </div>
        <div class='student-row'>
          <span>Classe: Moyenne Section (MS)</span>
        </div>
      </div>

      <!-- Title -->
      <div class='bulletin-title'>BULLETIN DE MI-SEMESTRE</div>

      <!-- Legend Table -->
      <table class='legend-table'>
        <tr>
          <td>Excellent</td>
          <td>Très Bien</td>
          <td>Bien</td>
          <td>Passable</td>
        </tr>
        <tr class='badge-row'>
          <td>
            <div class='badge badge-yellow'></div>
          </td>
          <td>
            <div class='badge badge-green'></div>
          </td>
          <td>
            <div class='badge badge-blue'></div>
          </td>
          <td>
            <div class='badge badge-orange'></div>
          </td>
        </tr>
      </table>

      <!-- Subjects Grid -->
      <table class='subjects-table'>
        <tr>
          <td class='subject-cell'>
            <div class='subject-name'>Activités Physiques</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Apprendre à vivre ensemble</div>
            <div class='badge badge-yellow'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Mobiliser le langage oral</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Mobiliser le langage écrit</div>
            <div class='badge badge-blue'></div>
          </td>
        </tr>
        <tr>
          <td class='subject-cell'>
            <div class='subject-name'>Outils Mathématiques</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Explorer le monde</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Activités Artistiques</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'></td>
        </tr>
      </table>

      <!-- Teacher Section -->
      <div class='teacher-section'>
        <div class='teacher-name'>Titulaire de la classe: KYAKIMWA KAKUNDIKA
          FURAHA</div>
        <div class='signature-placeholder'>Signature</div>
      </div>

      <!-- Footer -->
      <div class='footer'>
        <div class='director-section'>
          <div class='director-title'>DIRECTEUR: UGIRAMAHORO ISSA</div>
          <div class='director-title'>signature et cachet de l'école</div>
          <div class='signature-placeholder'>Signature</div>
        </div>
        <div class='school-stamp'>
          MALAIKA INTERNATIONAL SCHOOL<br />
          TEL: 0788532632<br />
          B.P 540<br />
          KIGALI - RWANDA
        </div>
      </div>
    </div>
  </body>
</html>