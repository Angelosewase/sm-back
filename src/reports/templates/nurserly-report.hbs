<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>School Report - Badges</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        padding: 20px;
        background-color: #f5f5f5;
      }

      .report-card {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border: 3px solid #000;
        padding: 0;
      }

      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        border-bottom: 2px solid #000;
      }

      .logo-placeholder {
        width: 150px;
        height: 80px;
        border: 2px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: #999;
      }

      .school-info {
        text-align: center;
        flex: 1;
        margin: 0 20px;
      }

      .school-name {
        font-weight: bold;
        font-size: 18px;
        color: #1E90FF;
        margin-bottom: 5px;
      }

      .school-details {
        font-size: 12px;
        line-height: 1.5;
      }

      .student-info {
        padding: 15px 20px;
        background-color: #f9f9f9;
        border-bottom: 2px solid #000;
        font-size: 13px;
        font-weight: bold;
      }

      .student-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
      }

      .bulletin-title {
        text-align: center;
        padding: 10px;
        font-weight: bold;
        border-bottom: 2px solid #000;
      }

      .legend-table {
        width: 100%;
        border-collapse: collapse;
      }

      .legend-table td {
        padding: 15px;
        text-align: center;
        border: 1px solid #000;
        background-color: #B3E5FF;
        font-weight: bold;
      }

      .badge-row td {
        background-color: white;
        padding: 20px;
      }

      .badge {
        width: 120px;
        height: 60px;
        border-radius: 50%;
        margin: 0 auto;
      }

      .badge-yellow {
        background-color: #ffd700;
      }

      .badge-green {
        background-color: #006400;
      }

      .badge-blue {
        background-color: #0000ff;
      }

      .badge-orange {
        background-color: #ff8c00;
      }

      .subjects-table {
        width: 100%;
        border-collapse: collapse;
      }

      .subjects-table td {
        padding: 15px;
        border: 1px solid #000;
        vertical-align: top;
      }

      .subject-cell {
        background-color: white;
      }

      .subject-name {
        font-size: 13px;
        margin-bottom: 10px;
      }

      .teacher-section {
        padding: 20px;
        border-top: 2px solid #000;
      }

      .teacher-name {
        font-size: 13px;
        margin-bottom: 10px;
      }

      .signature-placeholder {
        width: 200px;
        height: 60px;
        border: 2px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: #999;
        margin-top: 10px;
      }

      .footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
        border-top: 2px solid #000;
      }

      .director-section {
        flex: 1;
      }

      .school-stamp {
        width: 150px;
        height: 100px;
        border: 2px dashed #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #999;
        text-align: center;
        padding: 10px;
      }

      .director-title {
        font-weight: bold;
        font-size: 13px;
        margin-bottom: 5px;
      }
    </style>
  </head>
  <body>
    <div class='report-card'>
      <!-- Header -->
      <div class='header'>
        {{#if assets.logoPath}}
        <img src="{{assets.logoPath}}" alt="Logo" style="width:150px;height:80px;object-fit:contain;border:2px solid #ccc;" />
        {{else}}
        <div class='logo-placeholder'>Logo</div>
        {{/if}}
        <div class='school-info'>
          <div class='school-name'>{{#if school.name}}{{school.name}}{{else}}SCHOOL{{/if}}</div>
          <div class='school-details'>
            {{#if school.email}}{{school.email}}<br />{{/if}}
            {{#if school.phone}}Phone: {{school.phone}}{{/if}}
          </div>
        </div>
        <div class='logo-placeholder'>Cambridge Assessment</div>
      </div>

      <!-- Student Info -->
      <div class='student-info'>
        <div class='student-row'>
          <span>Student Name: {{student.fullName}}</span>
          <span>
            {{#if report.period}}
              {{#if report.periodLabel}}{{report.periodLabel}}: {{/if}}{{report.period}}
            {{/if}}
          </span>
        </div>
        <div class='student-row'>
          <span>Class: {{student.class}}</span>
        </div>
      </div>

      <!-- Title -->
      <div class='bulletin-title'>
        {{#if report.title}}{{report.title}}{{else}}MID-TERM REPORT{{/if}}
      </div>

      <!-- Legend Table -->
      <table class='legend-table'>
        <tr>
          <td>Excellent</td>
          <td>Very Good</td>
          <td>Good</td>
          <td>Pass</td>
        </tr>
        <tr class='badge-row'>
          <td>
            <div class='badge badge-yellow'></div>
          </td>
          <td>
            <div class='badge badge-green'></div>
          </td>
          <td>
            <div class='badge badge-blue'></div>
          </td>
          <td>
            <div class='badge badge-orange'></div>
          </td>
        </tr>
      </table>

      <!-- Subjects Grid -->
      <table class='subjects-table'>
        <tr>
          <td class='subject-cell'>
            <div class='subject-name'>Physical Activities</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Learn to live together</div>
            <div class='badge badge-yellow'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Develop oral language</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Develop written language</div>
            <div class='badge badge-blue'></div>
          </td>
        </tr>
        <tr>
          <td class='subject-cell'>
            <div class='subject-name'>Mathematics Tools</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Explore the world</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'>
            <div class='subject-name'>Artistic Activities</div>
            <div class='badge badge-green'></div>
          </td>
          <td class='subject-cell'></td>
        </tr>
      </table>

      <!-- Teacher Section -->
      <div class='teacher-section'>
        <div class='teacher-name'>
          {{#if teacher.name}}Class teacher: {{teacher.name}}{{else}}Class teacher{{/if}}
        </div>
        <div class='signature-placeholder'>Signature</div>
      </div>

      <!-- Footer -->
      <div class='footer'>
        <div class='director-section'>
          <div class='director-title'>DIRECTOR</div>
          <div class='director-title'>Signature and school stamp</div>
          <div class='signature-placeholder'>Signature</div>
        </div>
        <div class='school-stamp'>
          {{#if school.name}}{{school.name}}<br />{{/if}}
          {{#if school.phone}}TEL: {{school.phone}}<br />{{/if}}
          KIGALI - RWANDA
        </div>
      </div>
    </div>
  </body>
</html>